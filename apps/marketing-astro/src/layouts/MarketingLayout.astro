---
import 'astro-component-kit/global.css';
import '../styles/tokens.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  preview?: boolean;
}
const { title, description, canonical='https://artisys.dev/sistemas/', preview=true } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#080613" />
    <meta name="description" content={description} />
    <meta name="robots" content={preview ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ArtiSys" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="as-skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="as-header">
      <div class="as-container as-header-inner">
        <a class="as-brand" href="https://artisys.dev/" aria-label="ArtiSys, início">ARTISYS<span aria-hidden="true">.</span></a>
        <nav aria-label="Navegação comercial">
          <a href="https://artisys.dev/sistemas/">Todos os sistemas</a>
          <a href="https://artisys.dev/links/">Links</a>
        </nav>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="as-footer"><div class="as-container"><span>ArtiSys · Sistema e tecnologia para operações reais</span><a href="https://artisys.dev/">Página inicial</a></div></footer>
  </body>
</html>
<style>
  .as-skip{position:absolute;left:16px;top:-90px;background:white;color:#17102b;padding:12px;border-radius:10px;z-index:100}
  .as-skip:focus{top:12px}
  .as-header{border-bottom:1px solid var(--as-border);background:rgba(8,6,19,.95)}
  .as-header-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .as-brand{font-size:1.35rem;font-weight:850;letter-spacing:.08em}
  .as-brand span{color:var(--as-purple)}
  nav{display:flex;gap:24px;align-items:center;font-size:.9rem;color:var(--as-muted)}
  nav a:hover{color:var(--as-text)}
  .as-footer{border-top:1px solid var(--as-border);padding:30px 0;color:var(--as-muted);font-size:.86rem}
  .as-footer>div{display:flex;justify-content:space-between;gap:14px}
  @media(max-width:550px){nav{gap:10px;font-size:.76rem}.as-header-inner{min-height:66px}.as-footer>div{flex-direction:column}}
</style>
