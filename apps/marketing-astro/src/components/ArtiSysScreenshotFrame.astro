---
interface Props {
  src?: string;
  alt?: string;
  label: string;
  width?: number;
  height?: number;
  priority?: boolean;
}
const { src,alt,label,width=1440,height=900,priority=false } = Astro.props;
---
<figure class="as-frame">
  <div class="as-frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="as-frame-screen">
    {src
      ? <img src={src} alt={alt || label} width={width} height={height} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
      : <div class="as-frame-placeholder" role="img" aria-label="Screenshot não disponível"><p>Captura real ainda não vinculada</p></div>}
  </div>
  <figcaption>{label}</figcaption>
</figure>
<style>
  .as-frame{margin:0;border:1px solid var(--as-border-strong);background:var(--as-surface);border-radius:var(--as-radius-lg);overflow:hidden;box-shadow:var(--as-shadow)}
  .as-frame-bar{height:35px;display:flex;align-items:center;gap:7px;padding:0 14px;border-bottom:1px solid var(--as-border);background:#1e1434}
  .as-frame-bar span{width:8px;height:8px;border-radius:50%;background:#755a91}
  .as-frame-screen{aspect-ratio:16/10;background:#100b20;display:grid;place-items:center}
  .as-frame-screen img{display:block;width:100%;height:100%;object-fit:contain}
  .as-frame-placeholder{display:grid;place-items:center;min-height:240px;color:var(--as-muted);padding:24px;text-align:center}
  figcaption{padding:9px 16px;font-size:.77rem;color:var(--as-muted)}
</style>
