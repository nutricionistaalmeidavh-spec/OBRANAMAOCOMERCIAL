{
  "name": "obra-na-mao-comercial-online",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-build-meta.mjs && npm run assets:verify && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-09-02 --compatibility-flag=nodejs_compat",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate": "npm run d1:migrate:local",
    "assets:verify": "node scripts/verify-question-images.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply obra-na-mao-comercial --local",
    "d1:migrate:remote": "wrangler d1 migrations apply obra-na-mao-comercial --remote",
    "ux:verify": "node scripts/verify-ui-contract.mjs"
  },
  "dependencies": {
    "lucide": "^0.469.0",
    "pdfjs-dist": "^4.10.38"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "happy-dom": "^20.13.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
