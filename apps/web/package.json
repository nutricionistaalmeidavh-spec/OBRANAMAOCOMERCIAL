{
  "name": "obra-na-mao-comercial-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-learning-games-runtime.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-09-02 --compatibility-flag=nodejs_compat",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate": "wrangler d1 execute obra-na-mao-comercial --file cloudflare/migrations/0001_base.sql"
  },
  "dependencies": {
    "lucide": "^0.469.0",
    "pdfjs-dist": "^4.10.38"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
