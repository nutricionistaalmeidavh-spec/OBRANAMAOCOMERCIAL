{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obra-na-mao-comercial",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "OWNER_COMPANY": "Obra na Mão",
    "OWNER_PROJECT": "Operação Comercial",
    "OWNER_CUSTOMER": "Obra na Mão"
  }

  // D1 e R2 entram aqui depois que os recursos forem criados na conta.
  // O primeiro deploy fica propositalmente sem IDs hardcoded para permitir
  // que o frontend/PWA seja publicado imediatamente pelo Git.
}
