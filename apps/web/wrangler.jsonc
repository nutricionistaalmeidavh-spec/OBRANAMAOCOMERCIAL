{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obra-na-mao-comercial",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obra-na-mao-comercial",
      "database_id": "84bdb01f-94f6-4fb4-8c42-7bcdab0ac12a",
      "migrations_table": "d1_migrations",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "obra-na-mao-comercial-files"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "nutricionistaalmeidavh@gmail.com",
    "OWNER_COMPANY": "Obra na Mão",
    "OWNER_PROJECT": "Operação Comercial",
    "OWNER_CUSTOMER": "Obra na Mão",
    "GOOGLE_CLIENT_ID": "826322917381-ia1khl7es1gqddv6jsmg8p75m7amfle5.apps.googleusercontent.com"
  }
}
