# Nomes esperados no ambiente Cloudflare.
# Nunca salve valores reais neste arquivo.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
OWNER_EMAIL=nutricionistaalmeidavh@gmail.com
OWNER_COMPANY=Obra na Mão
OWNER_PROJECT=Operação Comercial
OWNER_CUSTOMER=Obra na Mão

# Central de Licenças do Painel Geral.
# Leitura e escrita usam segredos diferentes. Em produção, cadastre-os com `wrangler secret put`.
LICENSE_CENTER_READ_SECRET=
LICENSE_CENTER_WRITE_SECRET=
# Fail-closed: mantenha false até paridade e E2E estarem aprovados.
LICENSE_CENTER_WRITE_ENABLED=false

# ArtiSys Payments / Asaas. Use somente um host oficial permitido pelo adapter.
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Loja Online na Central Artisys.
# Em produção use Service Binding LOJAONLINE_LICENSING; esta URL é somente fallback local.
LOJAONLINE_LICENSE_SERVICE_SECRET=
LOJAONLINE_LICENSE_BASE_URL=http://127.0.0.1:4173
